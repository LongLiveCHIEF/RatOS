# shellcheck enable=require-variable-braces

## Source error handling, leave this in place
set -Eex

# Set LC_ALL to prevent errors
export LC_ALL=C

# Set DEBIAN_FRONTEND to noninteractive
if [[ "${DEBIAN_FRONTEND}" != "noninteractive" ]]; then
    export DEBIAN_FRONTEND=noninteractive
fi

# Source CustomPIOS common.sh
# shellcheck disable=SC1091
source /common.sh
install_cleanup_trap

run_as_base() {
    local base_home="/home/${BASE_USER}"
    if command -v runuser >/dev/null 2>&1; then
        runuser -u "${BASE_USER}" -- env HOME="${base_home}" USER="${BASE_USER}" LOGNAME="${BASE_USER}" PATH="$PATH" "$@"
    else
        HOME="${base_home}" USER="${BASE_USER}" LOGNAME="${BASE_USER}" sudo -u "${BASE_USER}" "$@"
    fi
}

echo_green "Install Input Shaper requirements ..."

### install all deps at once for time consumption reasons.
## APT: Update Repo Database and install Dependencies
# Force apt update
apt update
echo_green "Installing Input Shaper Dependencies ..."
# shellcheck disable=SC2086
# Disabling shellcheck SC2086, because we want "wordsplitting"
check_install_pkgs ${IS_REQ_PREINSTALL_DEPS}

### Check for Klipper Venv installed.
pushd "/home/${BASE_USER}" &> /dev/null || exit 1
if [[ -d "${IS_REQ_PREINSTALL_VENV_DIR}" ]] && [[ -x "${IS_REQ_PREINSTALL_VENV_DIR}/bin/pip" ]]; then
    echo_green "Installing numpy..."

    # Use modern build tooling inside the existing venv
    run_as_base "${IS_REQ_PREINSTALL_VENV_DIR}"/bin/pip install \
        --upgrade "pip>=24.2" "setuptools>=75" "wheel>=0.44" "Cython>=0.29.37"

    # Avoid pip’s isolated build env (which drags in old setuptools)
    export PIP_NO_BUILD_ISOLATION=1

    # Prefer a NumPy that supports Python 3.13. 2.1.x is fine.
    # This will build from source using the system BLAS you installed.
    run_as_base "${IS_REQ_PREINSTALL_VENV_DIR}"/bin/pip install -v \
        "numpy==2.1.*"

else
    echo_red "Klipper Venv not found!"
    return 1
fi

## Cleanup
echo_green "Cleanup ..."
run_as_base rm -rf "/home/${BASE_USER}/.cache"
popd  &> /dev/null || exit 1

unset PIP_NO_BUILD_ISOLATION

echo_green "Install Input Shaper requirements ... done!"

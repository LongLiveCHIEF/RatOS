#### Moonraker install for Armbian builds (CB1 / Trixie)
#### Runs fully in chroot without sudo, no EUID hacks.

# shellcheck enable=require-variable-braces

set -Eex
export LC_ALL=C

# Noninteractive apt in chroot
if [[ "${DEBIAN_FRONTEND}" != "noninteractive" ]]; then
    export DEBIAN_FRONTEND=noninteractive
fi

# CustomPiOS helpers
# shellcheck disable=SC1091
source /common.sh
install_cleanup_trap

run_as_base() {
    local base_home="/home/${BASE_USER}"
    if command -v runuser >/dev/null 2>&1; then
        runuser -u "${BASE_USER}" -- env HOME="${base_home}" USER="${BASE_USER}" LOGNAME="${BASE_USER}" PATH="$PATH" "$@"
    else
        HOME="${base_home}" USER="${BASE_USER}" LOGNAME="${BASE_USER}" sudo -u "${BASE_USER}" "$@"
    fi
}

# Paths / variables
MN_HOME="/home/${BASE_USER}"
MN_REPO_DIR="${MN_HOME}/moonraker"
MN_VENV="${MN_HOME}/moonraker-env"
MN_CONF_DIR="${MN_HOME}/printer_data/config"
MN_CONF="${MN_CONF_DIR}/moonraker.conf"
MN_SPEEDUPS_REQ="${MN_REPO_DIR}/scripts/moonraker-speedups.txt"
MN_REQUIREMENTS="${MN_REPO_DIR}/scripts/moonraker-requirements.txt"
MN_SERVICE="/etc/systemd/system/moonraker.service"

echo_green "Installing Moonraker and enabling service..."

# 1) Ensure apt works and install build/runtime deps (no sudo in chroot)
apt-get update
# Keep this list minimal and Debian Trixie-friendly; no deprecated atlas here.
check_install_pkgs \
  git python3-venv python3-dev python3-pip \
  build-essential pkg-config \
  zlib1g-dev libjpeg-dev libopenjp2-7 \
  libsodium-dev curl packagekit wireless-tools

# 2) Clone Moonraker as the app user (idempotent)
pushd "${MN_HOME}" >/dev/null
if [[ ! -d "${MN_REPO_DIR}/.git" ]]; then
    run_as_base git clone ${MOONRAKER_REPO:-https://github.com/Arksine/moonraker.git} moonraker
else
    run_as_base git -C "${MN_REPO_DIR}" fetch --depth=1 || true
    run_as_base git -C "${MN_REPO_DIR}" reset --hard @{u} || true
fi
popd >/dev/null

# 3) Create virtualenv and install python deps as the app user
if [[ ! -x "${MN_VENV}/bin/python" ]]; then
    run_as_base python3 -m venv "${MN_VENV}"
fi

# Upgrade bootstrap tools first (compatible with py3.13)
run_as_base "${MN_VENV}/bin/pip" install --upgrade pip setuptools wheel

# Install Moonraker requirements (fall back if file moves)
if [[ -f "${MN_REQUIREMENTS}" ]]; then
  run_as_base "${MN_VENV}/bin/pip" install -r "${MN_REQUIREMENTS}"
else
  # Conservative core deps if requirements file name changes upstream
  run_as_base "${MN_VENV}/bin/pip" install tornado pyyaml monotonic janus python-jose jsonschema requests
fi

# Speedups are optional – ignore if file missing
if [[ -f "${MN_SPEEDUPS_REQ}" ]]; then
  run_as_base "${MN_VENV}/bin/pip" install -r "${MN_SPEEDUPS_REQ}" || true
fi

# 4) PolicyKit rules (run as root, no sudo)
if [[ -x "${MN_REPO_DIR}/scripts/set-policykit-rules.sh" ]]; then
  bash "${MN_REPO_DIR}/scripts/set-policykit-rules.sh" --root || true
fi

# 5) Drop premade moonraker.conf from this module (keeps RatOS defaults)
echo_green "Copying RatOS premade moonraker.conf ..."
unpack /filesystem/home/"${BASE_USER}" /home/"${BASE_USER}" "${BASE_USER}"
mkdir -p "${MN_CONF_DIR}"
chown -R "${BASE_USER}:${BASE_USER}" "${MN_HOME}"

# 6) Create a systemd unit – avoid calling installer (which uses sudo)
cat > "${MN_SERVICE}" <<'UNIT'
[Unit]
Description=Moonraker API Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__BASE_USER__
Group=__BASE_USER__
WorkingDirectory=/home/__BASE_USER__/moonraker
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/__BASE_USER__/moonraker-env/bin/python -m moonraker --config /home/__BASE_USER__/printer_data/config/moonraker.conf
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
UNIT

sed -i "s|__BASE_USER__|${BASE_USER}|g" "${MN_SERVICE}"

# 7) Enable service
systemctl_if_exists enable moonraker.service

echo_green "Installing Moonraker and enabling service ... DONE!"

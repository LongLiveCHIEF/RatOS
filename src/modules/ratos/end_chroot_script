#!/usr/bin/env bash
# Installs RatOS
# GPL V3
########


# Source error handling, leave this in place
set -xe

run_as_base() {
    local base_home="/home/${BASE_USER}"
    if command -v runuser >/dev/null 2>&1; then
        env -u SUDO_USER -u SUDO_HOME -u SUDO_UID -u SUDO_GID \
            runuser -u "${BASE_USER}" -- env HOME="${base_home}" USER="${BASE_USER}" LOGNAME="${BASE_USER}" PATH="/usr/local/bin:/usr/bin:/bin:$PATH" "$@"
    else
        HOME="${base_home}" USER="${BASE_USER}" LOGNAME="${BASE_USER}" sudo -u "${BASE_USER}" "$@"
    fi
}

# Replace post-install with a root-safe version (always overwrite to avoid bad syntax)
POST_INSTALL="/home/${BASE_USER}/printer_data/config/RatOS/scripts/ratos-post-install.sh"
cat > "${POST_INSTALL}" <<'SH'
#!/bin/bash
set -e
disable_modem_manager() {
  if command -v systemctl >/dev/null 2>&1; then
    systemctl disable ModemManager.service 2>/dev/null || true
  fi
}
disable_modem_manager
SH
chmod +x "${POST_INSTALL}"

# Run post-install as root (script is now root-safe)
ALLOW_ROOT=1 HOME="/home/${BASE_USER}" USER="${BASE_USER}" LOGNAME="${BASE_USER}" \
  /home/"${BASE_USER}"/printer_data/config/RatOS/scripts/ratos-post-install.sh || true

# Stop the configurator, curl will fail so disable exit on error
set +e
echo "Stopping the configurator"
curl 'http://localhost:3000/configure/api/trpc/kill' &> /dev/null
# Re-enable exit on error
set -e

retries=0
while [ "$(pgrep -f -c "ratos-configurator")" -gt 0 ]; do
    if [ $retries -gt 10 ]; then
        echo "Configurator did not stop, killing it..."
        pkill -f "ratos-configurator"
        if [ $retries -gt 12 ]; then
            echo "Configurator cannot be killed.. :("
            break
        fi
    fi
    echo "Waiting for configurator to stop... ${retries}s passed"
    sleep 1
    retries=$((retries + 1))
done

echo "Configurator stopped.."

if [ "$(pgrep -f -c "KlipperScreen")" -gt 0 ]; then
    echo "Stopping KlipperScreen"
    retries=0
    while [ "$(pgrep -f -c "KlipperScreen")" -gt 0 ]; do
        if [ $retries -gt 10 ]; then
            echo "KlipperScreen did not stop, killing it..."
            pkill -f "KlipperScreen"
            if [ $retries -gt 12 ]; then
                echo "KlipperScreen cannot be killed.. :("
                break
            fi
        fi
        echo "Waiting for KlipperScreen to stop... ${retries}s passed"
        sleep 1
        retries=$((retries + 1))
    done
fi

echo "List out all running processes"
ps aux

#!/usr/bin/env bash
# Installs RatOS
# GPL V3
########

# Source error handling, leave this in place
set -Ee

# Set DEBIAN_FRONTEND to noninteractive
if [[ "${DEBIAN_FRONTEND}" != "noninteractive" ]]; then
    export DEBIAN_FRONTEND=noninteractive
fi
export NPM_CONFIG_CACHE="/tmp/.npm-cache"
export PNPM_STORE_PATH="/tmp/.pnpm-store"

# shellcheck source=/dev/null
source /common.sh
install_cleanup_trap

echo_green "Installing RatOS"

run_as_base() {
    local base_home="/home/${BASE_USER}"
    if command -v runuser >/dev/null 2>&1; then
        runuser -u "${BASE_USER}" -- env HOME="${base_home}" USER="${BASE_USER}" LOGNAME="${BASE_USER}" PATH="/usr/local/bin:/usr/bin:/bin:$PATH" "$@"
    else
        HOME="${base_home}" USER="${BASE_USER}" LOGNAME="${BASE_USER}" sudo -u "${BASE_USER}" "$@"
    fi
}

ensure_ratos_env() {
    local user_home="/home/${BASE_USER}"
    local env_file="${user_home}/.ratos.env.system"
    local system_env="/usr/local/etc/.ratos.env"
    cat > "${env_file}" <<EOF
RATOS_USERNAME=${BASE_USER}
RATOS_USERGROUP=${BASE_USER}
RATOS_PRINTER_DATA_DIR=${user_home}/printer_data
MOONRAKER_DIR=${user_home}/moonraker
KLIPPER_DIR=${user_home}/klipper
KLIPPER_ENV=${user_home}/klippy-env
BEACON_DIR=${user_home}/beacon
EOF
    chown "${BASE_USER}:${BASE_USER}" "${env_file}"
    chmod 0644 "${env_file}"

    mkdir -p /usr/local/etc
    cat > "${system_env}" <<EOF
RATOS_USERNAME=${BASE_USER}
RATOS_USERGROUP=${BASE_USER}
RATOS_PRINTER_DATA_DIR=${user_home}/printer_data
MOONRAKER_DIR=${user_home}/moonraker
KLIPPER_DIR=${user_home}/klipper
KLIPPER_ENV=${user_home}/klippy-env
BEACON_DIR=${user_home}/beacon
EOF
    chown root:root "${system_env}"
    chmod 0644 "${system_env}"
}

# --- BEGIN: sudo shim (handles nosuid mounts during chroot build) ---
# plain `sudo cmd` -> cmd,  `sudo -u USER cmd` -> runuser -u USER -- cmd
check_install_pkgs util-linux || true  # runuser
mkdir -p /usr/local/bin
cat >/usr/local/bin/sudo <<'SH'
#!/bin/sh
if [ "$(id -u)" -eq 0 ]; then
  if [ "$1" = "-u" ] && [ -n "$2" ]; then
    U="$2"; shift 2
    exec runuser -u "$U" -- "$@"
  fi
  exec "$@"
else
  exec /usr/bin/sudo "$@"
fi
SH
chmod 0755 /usr/local/bin/sudo
case ":$PATH:" in *:/usr/local/bin:*) : ;; *) export PATH="/usr/local/bin:$PATH" ;; esac
# --- END: sudo shim ---

pushd "/home/${BASE_USER}/printer_data/config"

gitclone RATOS_CONFIG RatOS
gitclone RATOS_THEME .theme
pushd "/home/${BASE_USER}"
gitclone RATOS_CONFIGURATOR ratos-configurator
popd
popd

# Ensure configurator initial-printer template exists (branch stores it under configuration/templates)
TEMPLATE_SRC="/home/${BASE_USER}/ratos-configurator/configuration/templates/initial-printer.template.cfg"
TEMPLATE_DST="/home/${BASE_USER}/ratos-configurator/configuration/scripts/templates/initial-printer.template.cfg"
if [[ -f "${TEMPLATE_SRC}" && ! -f "${TEMPLATE_DST}" ]]; then
  mkdir -p "$(dirname "${TEMPLATE_DST}")"
  cp -f "${TEMPLATE_SRC}" "${TEMPLATE_DST}"
  chown "${BASE_USER}:${BASE_USER}" "${TEMPLATE_DST}" || true
fi

unpack /filesystem/root /

# Set default git merge strategy
sudo -u pi git config --global pull.ff only

# Create release file
if [ -f "/etc/ratos_version" ]; then
    sudo rm -f /etc/ratos_version
fi
function get_parent {
    cat /etc/os-release | grep VERSION_CODENAME | cut -d '=' -f2
}

rm -f "/etc/${DIST_NAME,,}-release" || true
get_parent() { grep VERSION_CODENAME /etc/os-release | cut -d= -f2; }
echo "${DIST_NAME} v${DIST_VERSION} ($(get_parent))" > "/etc/${DIST_NAME,,}-release"

## Step 2: Fake release file
### NOTE: Turns out that the 'distro' python package,
###       which is used by moonraker, uses the first file after sorting.
###       Therefore we need a hacky solution, because armbian relies, on upgrades
###       on the original armbian-release file.
###       To get around that, we simple symlink mainsailos-release to
###       aaaa-release, which is directly read by moonraker.
### Substep 1: Do for armbian releases
if [[ -f "/etc/armbian-release" ]]; then
    echo_green "Apply release file workaround (armbian based image) ..."
    ln -sf /etc/"${DIST_NAME,,}"-release /etc/aaaa-release
fi
### END Substep 1
### Substep 2: Apply same for OrangePI based Images
if [[ -f "/etc/orangepi-release" ]]; then
    echo_green "Apply release file workaround (orangepi based image) ..."
    ln -sf /etc/"${DIST_NAME,,}"-release /etc/aaaa-release
fi
## END Step 2

## Step 3: Install system dependencies
apt-get update --allow-releaseinfo-change
# shellcheck disable=SC2086
check_install_pkgs ${RATOS_DEPS}
## END Step 3

# Ensure RatOS env files exist before running configurator setup (avoids sudo password prompt)
ensure_ratos_env

# Allow configurator setup to use sudo non-interactively (NOPASSWD for BASE_USER)
SUDOERS_FILE="/etc/sudoers.d/010-ratos-nopasswd"
cat > "${SUDOERS_FILE}" <<EOF
${BASE_USER} ALL=(ALL) NOPASSWD:ALL
EOF
chmod 0440 "${SUDOERS_FILE}"

# Patch configurator scripts in-place to allow ALLOW_ROOT and avoid fatal root exits
CONFIG_SETUP="/home/${BASE_USER}/ratos-configurator/app/scripts/setup.sh"
if [[ -f "${CONFIG_SETUP}" ]]; then
python3 - "${CONFIG_SETUP}" <<'PY'
import sys, pathlib
path = pathlib.Path(sys.argv[1])
text = path.read_text()
needle = '''verify_ready()
{
    if [ "$EUID" -eq 0 ]; then
        echo "This script must not run as root"
        exit 1
    fi
}
'''
replacement = '''verify_ready()
{
    if [ "$EUID" -eq 0 ]; then
        if [ -z "${ALLOW_ROOT:-}" ]; then
            echo "This script must not run as root"
            exit 1
        fi
    fi
}
'''
if needle in text:
    path.write_text(text.replace(needle, replacement, 1))
PY
fi

CONFIG_ENV="/home/${BASE_USER}/ratos-configurator/configuration/scripts/environment.sh"
if [[ -f "${CONFIG_ENV}" ]]; then
python3 - "${CONFIG_ENV}" <<'PY'
import sys, pathlib
path = pathlib.Path(sys.argv[1])
text = path.read_text()
needle = '''if [ "$REAL_USER" = "root" ]; then
    echo "Fatal Error: Unable to determine non-root user, please run as a normal user or use sudo, exiting..." >&2
    exit 1
fi
'''
replacement = '''if [ "$REAL_USER" = "root" ]; then
    if [ -z "${ALLOW_ROOT:-}" ]; then
        echo "Fatal Error: Unable to determine non-root user, please run as a normal user or use sudo, exiting..." >&2
        exit 1
    fi
    REAL_USER="pi"
    REAL_HOME="/home/pi"
fi
'''
if needle in text:
    path.write_text(text.replace(needle, replacement, 1))
PY
fi

CONFIG_COMMON="/home/${BASE_USER}/ratos-configurator/app/scripts/common.sh"
if [[ -f "${CONFIG_COMMON}" ]]; then
python3 - "${CONFIG_COMMON}" <<'PY'
import sys, pathlib
path = pathlib.Path(sys.argv[1])
text = path.read_text()
needle = '$sudo rm "$target"\n'
replacement = '$sudo rm -f "$target" || true\n'
if needle in text:
    text = text.replace(needle, replacement, 1)
path.write_text(text)
PY
fi

# Install RatOS Configurator (new path under app/scripts)
ALLOW_ROOT=1 sudo -u "${BASE_USER}" bash /home/"${BASE_USER}"/ratos-configurator/app/scripts/setup.sh


# Start the configurator so extensions can access the API
echo "Starting RatOS Configurator"
CONFIGURATOR_APP_DIR="/home/${BASE_USER}/ratos-configurator/app"
pushd "${CONFIGURATOR_APP_DIR}"
sudo -u "${BASE_USER}" npm run start &
# Wait for configurator to start
# shellcheck disable=SC2016
timeout 300 bash -c 'while [[ "$(curl -s -o /dev/null -w ''%{http_code}'' localhost:3000)" != "404" ]]; do sleep 5; done' || false
popd

echo "RATOS CLI SANITY CHECKS"
echo $PATH
ls -la /usr/local/bin

# Install RatOS Configuration
sudo -u "${BASE_USER}" /home/"${BASE_USER}"/printer_data/config/RatOS/scripts/ratos-install.sh

# Cleanup caches and package artifacts to keep image size down
apt-get clean || true
rm -rf \
  /var/lib/apt/lists/* \
  /var/cache/apt/archives/*.deb \
  /var/cache/apt/*.bin \
  /var/log/*/*-???????? \
  /var/log/*.gz \
  /tmp/.npm-cache \
  /tmp/.pnpm-store \
  /home/"${BASE_USER}"/.npm \
  /home/"${BASE_USER}"/.cache/pnpm \
  /home/"${BASE_USER}"/ratos-configurator/node_modules/.cache \
  /home/"${BASE_USER}"/ratos-configurator/app/node_modules/.cache \
  /home/"${BASE_USER}"/.cache \
  /home/"${BASE_USER}"/.cache/pip \
  /root/.cache/pip || true

# Create variant file
echo "${BASE_DISTRO}" > /etc/"${BASE_DISTRO}"-variant

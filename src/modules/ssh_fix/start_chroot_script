#!/usr/bin/env bash
# shellcheck enable=require-variable-braces

set -Eeuo pipefail
shopt -s inherit_errexit 2>/dev/null || true

# CustomPiOS helpers
# shellcheck disable=SC1091
source /common.sh
install_cleanup_trap

SSHD_CONFIG="/etc/ssh/sshd_config"
SSH_CONFIG="/etc/ssh/ssh_config"

# Remove invalid/deprecated IPQoS directives and set a safe default
for cfg in "${SSHD_CONFIG}" "${SSH_CONFIG}"; do
  if [[ -f "${cfg}" ]]; then
    sed -i '/^\s*IPQoS\b/d' "${cfg}"
    echo "IPQoS throughput" >> "${cfg}"
  fi
done
